            "text": "import api from \"/src/services/api.ts\";\nconst AGENT_BASE_URL = \"/api/v1/agents\";\nexport async function getMyAgents() {\n  const response = await api.get(`${AGENT_BASE_URL}/my`);\n  return response.data;\n}\nexport async function getSubordinateAgents() {\n  const response = await api.get(`${AGENT_BASE_URL}/subordinates`);\n  return response.data;\n}\nexport async function getAgentById(id) {\n  const response = await api.get(`${AGENT_BASE_URL}/${id}`);\n  return response.data;\n}\nexport async function createAgent(form) {\n  const response = await api.post(`${AGENT_BASE_URL}/`, form);\n  return response.data;\n}\nexport async function updateAgent(id, form) {\n  const response = await api.put(`${AGENT_BASE_URL}/${id}`, form);\n  return response.data;\n}\nexport async function deleteAgent(id) {\n  const response = await api.delete(`${AGENT_BASE_URL}/${id}`);\n  return response.data;\n}\n\n//# sourceMappingURL=data:application/json;base64,"
